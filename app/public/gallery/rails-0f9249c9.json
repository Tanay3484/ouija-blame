ost": false}], "medium": "The reviews highlight a shift from delayed delivery to a delivery job, a reliance on a workaround for Ruby's mixin method overriding, and a separation of concerns between ActionMailer and Active Job.", "stats": {"commits_walked": 3, "sources": 206, "passages": 277, "shown_to_model": 16, "dropped_by_checker": 0, "model_error": null}, "case": {"id": "rails-0f9249c9", "revert": "336a07b9a4cac47cecf7dcf089f0bcc4cc6cadd8", "deletion": "0f9249c93f402d276730fcfaba1ed1b876ee7c26", "deletion_subject": "Remove deprecated `ActionMailer::DeliveryJob` and `ActionMailer::Parameterized::DeliveryJob`", "cutoff": "2020-05-05T00:31:14-04:00"}, "revert_subject": "Revert \"Remove deprecated `ActionMailer::DeliveryJob` and `ActionMailer::Parameterized::DeliveryJob`\"", "answer": "The deprecation did not warn for custom jobs, so applications may never have seen it; DeliveryJob must stay until they can migrate."}